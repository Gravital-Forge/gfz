set -euo pipefail

agent_uid="$(id -u "{{ agent_user }}")"

if ! grep -qF "# Rootless Docker" "{{ agent_home }}/.bashrc" 2>/dev/null; then
  sudo -u "{{ agent_user }}" tee -a "{{ agent_home }}/.bashrc" >/dev/null <<'EOF'

# Rootless Docker
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/docker.sock"
EOF
fi

sudo -u "{{ agent_user }}" mkdir -p "{{ agent_home }}/.config/environment.d"
sudo -u "{{ agent_user }}" tee "{{ agent_home }}/.config/environment.d/10-docker.conf" >/dev/null <<EOF
DOCKER_HOST=unix:///run/user/${agent_uid}/docker.sock
EOF
