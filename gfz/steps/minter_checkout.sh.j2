set -euo pipefail

checkout="{{ harness_checkout }}"

# The provisioning session has no terminal, so ssh cannot prompt about an
# unknown host key. gfz's own transport accepts a new one the same way.
export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new"

if [ -d "$checkout/.git" ]; then
  git -C "$checkout" pull --ff-only --quiet
else
  git clone --quiet "{{ harness_repo }}" "$checkout"
fi
