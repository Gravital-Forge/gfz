set -euo pipefail

{% include "_repo_directory.j2" %}
{% if repos %}
# Creating the workspace here would make clone-harness report it as already
# there and skip the harness clone for good.
if ! sudo test -d "{{ workspace }}"; then
  echo "{{ workspace }} is not there; run the clone-harness step first" >&2
  exit 1
fi

{% include "_github_origin.j2" %}

{% include "_agent_clone.j2" %}

projects="{{ workspace }}/projects"
sudo -u "{{ agent_user }}" -H mkdir -p "$projects"

clone_repo() {
  local remote="$1"
  local name
  name="$(repo_directory "$remote")"

  if sudo test -e "$projects/$name"; then
    echo "$name is already there; leaving it as found"
    return
  fi

  agent_clone "$remote" "$projects/$name"
  echo "cloned $name"
}

{% for repo in repos %}
clone_repo "{{ repo }}"
{% endfor %}
{% else %}
echo "no repositories are configured; nothing to clone"
{% endif %}
