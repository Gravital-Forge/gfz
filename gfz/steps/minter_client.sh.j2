set -euo pipefail

client_dir="{{ harness_checkout }}/tools/github-app-minter/client"
if [ ! -d "$client_dir" ]; then
  echo "$client_dir is not there; run the minter-checkout step first" >&2
  exit 1
fi

agent_bin="{{ agent_home }}/.local/bin"
if [ ! -d "$agent_bin" ]; then
  echo "$agent_bin is not there; run the agent-tooling step first" >&2
  exit 1
fi

install -o "{{ agent_user }}" -g "{{ agent_user }}" -m 755 "$client_dir"/* "$agent_bin/"

# `sudo -u … -i` drops an empty argument, so git config runs without a login
# shell, and from `/`, since the agent cannot read root's home.
agent_git() { (cd / && sudo -u "{{ agent_user }}" git config --file "{{ agent_home }}/.gitconfig" "$@"); }

agent_git --replace-all credential.https://github.com.helper ''
agent_git --add credential.https://github.com.helper github-app
agent_git user.name {{ git_name | shell_quote }}
agent_git user.email {{ git_email | shell_quote }}

agent_gh="$(sudo -u "{{ agent_user }}" -i sh -c 'command -v gh' || true)"
if [ "$agent_gh" != "$agent_bin/gh" ]; then
  echo "{{ agent_user }}'s gh resolves to ${agent_gh:-nothing}, not $agent_bin/gh: ~/.local/bin comes after the real gh on its PATH; put it first" >&2
  exit 1
fi
