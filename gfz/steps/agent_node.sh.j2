set -euo pipefail

{% include "_apt.j2" %}
apt_get update
apt_get install -y libatomic1

if [ ! -f "{{ agent_home }}/.nvm/nvm.sh" ]; then
  sudo -u "{{ agent_user }}" -i bash -c \
    'curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh | bash'
fi

sudo -u "{{ agent_user }}" -i bash -c \
  '. ~/.nvm/nvm.sh && nvm install 24 && corepack enable pnpm'
