set -euo pipefail

bearer_dir="{{ agent_home }}/.config/github-app-minter"
bearer="{{ agent_home }}/.config/github-app-minter/bearer"

# A new bearer invalidates the one the agent holds, so a re-run never rotates it.
if [ -s "$bearer" ]; then
  echo "{{ agent_user }} already holds a minter bearer; leaving it as found"
  exit 0
fi

if ! docker container inspect {{ minter_container }} >/dev/null 2>&1; then
  echo "the {{ minter_container }} container is not there; run the minter step first" >&2
  exit 1
fi

# The agent's commands never start in root's home, which the agent cannot read.
cd /
sudo -u "{{ agent_user }}" mkdir -p -m 700 "$bearer_dir"
docker exec {{ minter_container }} github-app-minter bearer new \
  | sudo -u "{{ agent_user }}" sh -c 'umask 077 && cat > "$1"' sh "$bearer"
