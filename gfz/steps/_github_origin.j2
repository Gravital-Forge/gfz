# The minter's credential helper answers git for https://github.com alone.
github_origin() {
  local path
  case "$1" in
    git@github.com:*) path="${1#git@github.com:}" ;;
    ssh://git@github.com/*) path="${1#ssh://git@github.com/}" ;;
    https://github.com/*) path="${1#https://github.com/}" ;;
    *)
      echo "$1 is not a GitHub remote; the App's token reaches github.com only" >&2
      return 1
      ;;
  esac
  printf 'https://github.com/%s.git\n' "${path%.git}"
}
