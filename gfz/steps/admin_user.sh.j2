set -euo pipefail

if ! id -u "{{ admin_user }}" >/dev/null 2>&1; then
  useradd --create-home --user-group --shell /bin/bash "{{ admin_user }}"
fi

# A plain `visudo -c` reads the live tree, so a drop-in checked in place has
# already taken effect, and a bad one has already broken sudo. The file name
# carries no username: sudo ignores any name in sudoers.d holding a dot.
sudoers_tmp="$(mktemp)"
trap 'rm -f "$sudoers_tmp"' EXIT
echo "{{ admin_user }} ALL=(ALL) NOPASSWD:ALL" > "$sudoers_tmp"
visudo -cf "$sudoers_tmp"
install -m 0440 -o root -g root "$sudoers_tmp" /etc/sudoers.d/90-gfz-admin

install -d -m 0700 -o "{{ admin_user }}" -g "{{ admin_user }}" "{{ admin_home }}/.ssh"
target="{{ admin_home }}/.ssh/authorized_keys"
touch "$target"
while IFS= read -r line || [ -n "$line" ]; do
  grep -qxF -- "$line" "$target" || printf '%s\n' "$line" >> "$target"
done < /root/.ssh/authorized_keys
chmod 0600 "$target"
chown "{{ admin_user }}:{{ admin_user }}" "$target"
