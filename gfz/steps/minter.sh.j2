set -euo pipefail

source_dir="{{ harness_checkout }}/tools/github-app-minter"
if [ ! -d "$source_dir" ]; then
  echo "$source_dir is not there; run the minter-checkout step first" >&2
  exit 1
fi

docker build --quiet --tag {{ minter_container }} "$source_dir" >/dev/null

# Docker's --format templates share Jinja's braces, which this template would
# render away, so python3 reads the inspect output instead. A list prints one
# entry per line.
inspect_field() {
  python3 -c '
import json
import sys

value = json.load(sys.stdin)[0]
for key in sys.argv[1].split("."):
    value = value[key]
for entry in value if isinstance(value, list) else [value]:
    print(entry if isinstance(entry, str) else json.dumps(entry))
' "$1"
}

built_image="$(docker image inspect {{ minter_container }} | inspect_field Id)"

container_matches() {
  local env
  env="$(inspect_field Config.Env <<<"$container")"
  [ "$(inspect_field Image <<<"$container")" = "$built_image" ] \
    && grep -qxF "GITHUB_APP_ID={{ github_app_id }}" <<<"$env" \
    && grep -qxF "GITHUB_APP_INSTALLATION_ID={{ github_app_installation_id }}" <<<"$env"
}

kept=false
if container="$(docker container inspect {{ minter_container }} 2>/dev/null)"; then
  if container_matches; then
    kept=true
    if [ "$(inspect_field State.Running <<<"$container")" = false ]; then
      docker start {{ minter_container }} >/dev/null
    fi
  else
    docker rm -f {{ minter_container }} >/dev/null
  fi
fi

if [ "$kept" = false ]; then
  docker run -d --name {{ minter_container }} --restart unless-stopped \
    --read-only --cap-drop ALL --security-opt no-new-privileges \
    -p 127.0.0.1:8790:8080 -v github-app-minter:/data \
    -e GITHUB_APP_ID="{{ github_app_id }}" \
    -e GITHUB_APP_INSTALLATION_ID="{{ github_app_installation_id }}" \
    {{ minter_container }} >/dev/null
fi

for _ in $(seq 30); do
  if [ "$(curl -fsS -m 2 http://127.0.0.1:8790/healthz)" = ok ]; then
    exit 0
  fi
  sleep 1
done
docker logs --tail 20 {{ minter_container }} >&2
echo "the minter did not answer on 127.0.0.1:8790 within 30 seconds" >&2
exit 1
